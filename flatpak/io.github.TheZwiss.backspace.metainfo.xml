<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.TheZwiss.backspace</id>
  <name>Backspace</name>
  <summary>Self-hosted text, voice, and video communication</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <developer id="io.github.thezwiss">
    <name>Jannis Braun</name>
  </developer>

  <description>
    <p>
      Backspace is a client for self-hosted Backspace communities. Connect to
      an instance to chat in spaces and direct messages, make voice and video
      calls, share your screen, and communicate with users on federated
      instances.
    </p>
    <p>
      The desktop client adds native notifications, a system tray, deep links,
      and global push-to-talk keybinds where supported by the desktop
      environment.
    </p>
  </description>

  <launchable type="desktop-id">io.github.TheZwiss.backspace.desktop</launchable>
  <url type="homepage">https://github.com/TheZwiss/backspace</url>
  <url type="bugtracker">https://github.com/TheZwiss/backspace/issues</url>
  <url type="vcs-browser">https://github.com/TheZwiss/backspace</url>
  <url type="help">https://github.com/TheZwiss/backspace#readme</url>
  <provides>
    <binary>backspace</binary>
    <mediatype>x-scheme-handler/backspace</mediatype>
  </provides>
  <categories>
    <category>Network</category>
    <category>Chat</category>
    <category>InstantMessaging</category>
  </categories>
  <keywords>
    <keyword>chat</keyword>
    <keyword>voice</keyword>
    <keyword>video</keyword>
    <keyword>federation</keyword>
    <keyword>self-hosted</keyword>
  </keywords>
  <content_rating type="oars-1.1" />

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/TheZwiss/backspace/v1.0.0/docs/screenshots/chat.webp</image>
      <caption>Text channels with replies, reactions, and typing indicators</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/TheZwiss/backspace/v1.0.0/docs/screenshots/voice-video-grid.webp</image>
      <caption>Voice and video calls with screen sharing</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/TheZwiss/backspace/v1.0.0/docs/screenshots/user-discovery.webp</image>
      <caption>Discover users across federated instances</caption>
    </screenshot>
  </screenshots>


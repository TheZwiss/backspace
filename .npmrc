# pnpm's strict node_modules layout hides vitest's own sub-packages
# (@vitest/expect, @vitest/runner, ...) from any resolver that looks them up
# from a workspace package's directory rather than from vitest's own.
# @cloudflare/vitest-pool-workers is such a resolver: it builds the module
# registry for the workerd sandbox by resolving from the test project root, so
# scripts/telemetry-receiver could not start its Workers test runtime at all
# ("@vitest/expect does not provide an export named ...").
#
# Hoisting the @vitest scope into the workspace root node_modules makes those
# packages resolvable from every workspace package, which is what the pool
# expects. Layout only: the lockfile and the resolved versions do not change.
#
# The two defaults are restated because setting this key replaces pnpm's
# default value rather than adding to it.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@vitest/*

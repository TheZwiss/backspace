port: 7880

bind_addresses:
  - 0.0.0.0

rtc:
  # Advertise ONLY the Android Tailscale IP. Advertising the LAN IP as well made
  # remote clients pair against both addresses and the ICE selected pair flipped
  # every 2-6 s (about 47 switches in 5 min), which showed up as ping spikes.
  # See INSTALACAO-ANDROID-PROOT.md, section 5.
  node_ip: <TAILSCALE_IP>
  advertise_internal_ip: false
  ips:
    excludes:
      - <LAN_CIDR>   # e.g. 10.0.0.0/8; keeps the wlan0 address out of the candidates
  use_external_ip: false
  udp_port: 7882
  tcp_port: 7881

logging:
  level: info
keys:
  <LIVEKIT_API_KEY>: <LIVEKIT_API_SECRET>

turn:
  enabled: true
  domain: <MAGICDNS_NAME>
  cert_file: /opt/caddy/certs/<HOST>.crt
  key_file: /opt/caddy/certs/<HOST>.key
  udp_port: 3478
  tcp_port: 3479
  proxy_protocol: true
  proxy_protocol_trusted_cidrs:
    - 127.0.0.0/8
    - ::1/128
  tls_port: 0
  relay_range_start: 30000
  relay_range_end: 40000
  allow_restricted_peer_cidrs:
    - 10.0.0.0/8
    - 100.64.0.0/10
    - 127.0.0.0/8
    - fd00::/8

{
  "name": "@backspace/desktop",
  "version": "1.11.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Backspace",
  "author": {
    "name": "Jannis Braun",
    "email": "backspace@backspace.chat"
  },
  "homepage": "https://github.com/TheZwiss/backspace",
  "main": "dist/main.js",
  "desktopName": "io.github.TheZwiss.backspace.desktop",
  "scripts": {
    "build:ts": "tsc && node scripts/buildTextVoice.mjs",
    "dev": "pnpm build:ts && electron .",
    "build": "pnpm build:ts && electron-builder",
    "build:all": "pnpm build:ts && electron-builder --mac --win --linux --arm64 --x64",
    "clean": "rm -rf dist dist-electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-rebuild -f -w uiohook-napi || node -e \"console.warn('[desktop] uiohook-napi native rebuild skipped - needs build tools (make, g++, python3). Only required to RUN the desktop app; the server, web client, and Docker image are unaffected.')\""
  },
  "dependencies": {
    "dbus-next": "0.10.2",
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "optionalDependencies": {
    "@vencord/venmic": "7.2.3"
  },
  "devDependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "esbuild": "0.27.4",
    "onnxruntime-web": "1.31.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
